{
	"name": "dimgui",
	"targetName": "DImGui",
	"description": "An example of calling imgui from D.",
	"authors": ["Danny Arends"],
	"homepage": "http://www.dannyarends.nl",
	"copyright": "Copyright © 2025, Danny Arends",
	"license": "GPL-v3",
	"configurations": [
	{
		"name": "default",
		"targetType": "executable",
		"targetPath": "bin",
		"platforms": ["linux", "windows"],
		"sourceFiles": ["src/includes.c"],
		"sourceFiles-windows": ["app/windows/CalderaD.res"],
		"libs-linux": ["SDL3", "SDL3_image", "SDL3_mixer", "freetype", "cimgui", "cvma", "vulkan", "shaderc_shared", "spirv-cross-c-shared", "assimp"],
		"libs-windows": ["SDL3", "SDL3_image", "SDL3_mixer", "freetype", "CImGui", "cvma", "vulkan-1", "shaderc_shared", "spirv-cross-c-shared", "assimp-vc142-mt"],
		"dflags": ["-J$PACKAGE_DIR/app/src/main/assets",
							 "-P-I$PACKAGE_DIR/src/icons/",
							 "-P-I$PACKAGE_DIR/app/jni/SDL/include/",
							 "-P-I$PACKAGE_DIR/app/jni/SDL_image/include/",
							 "-P-I$PACKAGE_DIR/app/jni/SDL_mixer/include/",
							 "-P-I$PACKAGE_DIR/app/jni/freetype/include/",
							 "-P-I$PACKAGE_DIR/app/jni/vma/include/",
							 "-P-I$PACKAGE_DIR/app/jni/assimp/include/",
							 "-P-I$PACKAGE_DIR/app/jni/build/assimp_build/include/",
							 "-P-I$PACKAGE_DIR/app/jni/shaderc/libshaderc/include/",
							 "-P-I$PACKAGE_DIR/app/jni/",
							 "-P-I$PACKAGE_DIR/app/jni/cimgui/"],
		"dflags-windows": ["-P-IC:/VulkanSDK/1.4.341.1/Include"],
		"lflags-windows": ["/LIBPATH:$PACKAGE_DIR/app/jni/build/libs",
											 "/LIBPATH:C:/VulkanSDK/1.4.341.1/Lib"],
		"copyFiles-windows":[ "$PACKAGE_DIR/app/jni/build/libs/SDL3.dll",
													"$PACKAGE_DIR/app/jni/build/libs/SDL3_image.dll",
													"$PACKAGE_DIR/app/jni/build/libs/SDL3_mixer.dll",
													"$PACKAGE_DIR/app/jni/build/libs/freetype.dll",
													"$PACKAGE_DIR/app/jni/build/libs/cvma.dll",
													"$PACKAGE_DIR/app/jni/build/libs/cimgui.dll",
													"$PACKAGE_DIR/app/jni/build/libs/assimp-vc142-mt.dll",
													"$PACKAGE_DIR/app/jni/build/libs/shaderc_shared.dll",
													"$PACKAGE_DIR/app/jni/build/libs/SPIRV-Tools.dll",
													"$PACKAGE_DIR/app/jni/build/libs/SPIRV-Tools-opt.dll",
													"$PACKAGE_DIR/app/jni/build/libs/glslang.dll",
													"$PACKAGE_DIR/app/jni/build/libs/libpng16-16.dll",
													"$PACKAGE_DIR/app/jni/build/libs/spirv-cross-c-shared.dll"],
		"lflags-linux": ["-rpath=$PACKAGE_DIR/bin",
										 "-L$PACKAGE_DIR/app/jni/build/libs"],
		"copyFiles-linux":["$PACKAGE_DIR/app/jni/build/libs/*.so*"],
	},
	{
		"name": "android-64",
		"targetType": "dynamicLibrary",
		"targetPath": "app/src/main/jniLibs/arm64-v8a",
		"targetName": "main",
		"dflags": ["-J$PACKAGE_DIR/app/src/main/assets",
							 "-P-D__builtin_va_list=void*",
							 "-P-D__alignof__(x)=__alignof(x)",
							 "-P-I$PACKAGE_DIR/src/icons/",
							 "-P-I$PACKAGE_DIR/app/jni/SDL/include/",
							 "-P-I$PACKAGE_DIR/app/jni/freetype/include/",
							 "-P-I$PACKAGE_DIR/app/jni/SDL_image/include/",
							 "-P-I$PACKAGE_DIR/app/jni/SDL_mixer/include/",
							 "-P-I$PACKAGE_DIR/app/jni/shaderc/libshaderc/include/",
							 "-P-I$PACKAGE_DIR/app/jni/",
							 "-P-I$PACKAGE_DIR/app/jni/cimgui/",
							 "-P-I$PACKAGE_DIR/app/jni/vma/include/",
							 "-P-I$PACKAGE_DIR/app/jni/cimgui/imgui/",
							 "-P-I$PACKAGE_DIR/app/jni/assimp/include/",
							 "-P-I$PACKAGE_DIR/app/jni/assimp/build/include/"],
		"lflags": [ "-L$PACKAGE_DIR/app/build/intermediates/cxx/Release/9t656d2k/obj/arm64-v8a" ],
		"libs": ["SDL3", "SDL3_image", "SDL3_mixer", "freetype", "cvma", "vulkan", "shaderc_shared", "spirv-cross-c-shared", "cimgui", "assimp"]
	}
]
}

